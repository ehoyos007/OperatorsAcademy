{
  "env": {
    "ENABLE_TOOL_SEARCH": "false"
  },
  "permissions": {
    "allow": []
  },
  "options": {
    "effortLevel": "high"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/auto-init-check.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-logger.sh",
            "timeout": 2000
          }
        ]
      }
    ]
  }
}
